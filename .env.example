# Copie para .env (o .env NUNCA vai para o Git) e preencha só o que tiver.
# Tudo aqui é opcional: sem estas chaves, o Reddit é coletado pelo navegador logado.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Modo híbrido: onde está o repositório na VPS (login por chave SSH, nunca senha aqui)
PESQUISA_VPS=
